<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:opencv="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    >

    <com.beeinc.mylibrary.views.Tutorial3View
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:visibility="gone"
        android:id="@+id/cameraView"
        opencv:show_fps="false"
        opencv:camera_id="any" />
    <TextView
        android:id = "@+id/tv_close"
        android:layout_width="100px"
        android:layout_height="40px"
        android:layout_marginTop="30px"
        android:text = "取消"
        android:textSize="20px"
        android:textColor="#ffffff"
        android:gravity="center"
        android:layout_gravity="right"
        />

    <FrameLayout
        android:id="@+id/frame_options"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="right|center_vertical"
        android:layout_marginRight="24px"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/iv_single"
            android:layout_width="60px"
            android:layout_height="60px"
            android:layout_gravity="center_horizontal" />

        <ImageView
            android:id="@+id/iv_vertical_two"
            android:layout_width="60px"
            android:layout_height="60px"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="52px" />

        <ImageView
            android:id="@+id/iv_capture"
            android:layout_width="62px"
            android:layout_height="62px"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="114px" />

        <ImageView
            android:id="@+id/iv_horizontal_two"
            android:layout_width="60px"
            android:layout_height="60px"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="188px" />

        <ImageView
            android:id="@+id/iv_four"
            android:layout_width="60px"
            android:layout_height="60px"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="240px" />
    </FrameLayout>
    <ImageView
        android:id = "@+id/iv_album"
        android:layout_width="60px"
        android:layout_height="60px"
        android:layout_marginRight="20px"
        android:layout_marginBottom="100px"
        android:layout_gravity="bottom|right"
        />
</FrameLayout>
