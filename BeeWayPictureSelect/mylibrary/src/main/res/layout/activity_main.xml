<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    >

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            >
            <Button
                android:id="@+id/tv_upload_pictures"
                android:layout_width="match_parent"
                android:layout_height = "40dp"
                android:text="多图修图上传"
                android:layout_marginBottom="10dp"
                ></Button>
            <Button
                android:id="@+id/testcut"
                android:layout_width="match_parent"
                android:layout_height = "40dp"
                android:text="裁剪测试"
                android:layout_marginBottom="10dp"
                ></Button>
            <Button
                android:id="@+id/button_jingixangpai"
                android:layout_width="match_parent"
                android:layout_height = "40dp"
                android:text="镜像拍"
                android:layout_marginBottom="10dp"
                ></Button>
            <Button
                android:id="@+id/button_ar"
                android:layout_width="match_parent"
                android:layout_height = "40dp"
                android:text="AR拍照"
                android:layout_marginBottom="10dp"
                ></Button>
            <Button
                android:id="@+id/cut_capture"
                android:layout_width="match_parent"
                android:layout_height = "40dp"
                android:text="切割拍照"
                android:layout_marginBottom="10dp"
                ></Button>
            <Button
                android:id="@+id/duihua_capture"
                android:layout_width="match_parent"
                android:layout_height = "40dp"
                android:text="对花拍照"
                android:layout_marginBottom="10dp"
                ></Button>
            <Button
                android:id="@+id/share"
                android:layout_width="match_parent"
                android:layout_height = "40dp"
                android:text="分享"
                android:layout_marginBottom="10dp"
                ></Button>
            <Button
                android:id="@+id/upload"
                android:layout_width="match_parent"
                android:layout_height = "40dp"
                android:text="多图上传"
                android:layout_marginBottom="10dp"
                ></Button>
            <Button
                android:id="@+id/showNavigationButton"
                android:layout_width="match_parent"
                android:layout_height = "40dp"
                android:text="显示状态栏"
                android:layout_marginBottom="10dp"
                ></Button>
            <Button
                android:id="@+id/hideNavigationButton"
                android:layout_width="match_parent"
                android:layout_height = "40dp"
                android:text="隐藏状态栏"
                android:layout_marginBottom="10dp"
                ></Button>
        </LinearLayout>
    </ScrollView>

</LinearLayout>
