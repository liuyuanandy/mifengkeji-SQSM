<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id = "@+id/frame_auto_fail"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    >
    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        >
        <View
            android:id = "@+id/v_auto_fail_back"
            android:layout_width="150px"
            android:layout_height="150px"
            android:background="@drawable/shape_14"
            ></View>
        <ImageView
            android:id ="@+id/iv_auto_fail_picture"
            android:layout_width="50px"
            android:layout_height="50px"
            android:layout_marginLeft="50px"
            android:layout_marginTop="24px"
            android:src = "@mipmap/b_icon_auto_fix_faild"
            ></ImageView>
        <TextView
            android:id = "@+id/tv_auto_fail_text"
            android:layout_width="150px"
            android:layout_height="66px"
            android:layout_marginTop="76px"
            android:textSize="18px"
            android:text="@string/enhancing_failed"
            android:textColor="#ffffff"
            android:gravity="center"
            />
        <TextView
            android:id = "@+id/tv_auto_fail_hint"
            android:layout_width="150px"
            android:layout_height="40px"
            android:layout_marginTop="114px"
            android:textSize="14px"
            android:text="@string/stones_not_detected"
            android:textColor="@color/colorB3B3B3"
            android:gravity="center"
            />
    </FrameLayout>
</FrameLayout>