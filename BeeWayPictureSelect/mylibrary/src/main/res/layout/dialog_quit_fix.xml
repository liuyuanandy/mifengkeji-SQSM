<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    >
    <View
        android:id = "@+id/v_back"
        android:layout_width="388px"
        android:layout_height="210px"
        android:background="@drawable/shape_25"
        android:alpha="0.7"
        ></View>
    <TextView
        android:id = "@+id/tv_hint_title"
        android:layout_width="388px"
        android:layout_height="40px"
        android:layout_marginTop="26px"
        android:textSize="28px"
        android:text="@string/caution"
        android:gravity="center"
        android:textColor="@color/colorFFFFFF"/>
    <TextView
        android:id = "@+id/tv_hint_content"
        android:layout_width="388px"
        android:layout_height="30px"
        android:layout_marginTop="75px"
        android:textSize="22px"
        android:text="@string/give_up_photo_eidting"
        android:gravity="center"
        android:textColor="@color/colorFFFFFF"/>
    <View
        android:id = "@+id/v_horizontal"
        android:layout_width="388px"
        android:layout_height="1px"
        android:layout_marginTop="144px"
        android:background="@color/colorFFFFFF"></View>
    <TextView
        android:id = "@+id/tv_cancel"
        android:layout_width="194px"
        android:layout_height="60px"
        android:layout_marginTop="146px"
        android:textSize="28px"
        android:text="@string/not_now"
        android:gravity="center"
        android:textColor="@color/color00BABA"/>
    <View
        android:id = "@+id/v_vertical"
        android:layout_width="1px"
        android:layout_height="60px"
        android:layout_marginLeft="194px"
        android:layout_marginTop="146px"
        android:background="@color/colorFFFFFF"></View>
    <TextView
        android:id = "@+id/tv_quit"
        android:layout_width="194px"
        android:layout_height="60px"
        android:layout_marginLeft="194px"
        android:layout_marginTop="146px"
        android:textSize="28px"
        android:text="@string/give_up"
        android:gravity="center"
        android:textColor="@color/color00BABA"/>
</FrameLayout>