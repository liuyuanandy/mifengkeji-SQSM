<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id = "@+id/frame_manu_option_tiaose"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    >
    <View
        android:id = "@+id/v_tiaose_back"
        android:layout_width="1280px"
        android:layout_height="120px"
        android:background="@color/color393939"
        ></View>
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="horizontal">
        <ImageView
            android:id = "@+id/iv_tiaose_hint"
            android:layout_width="28px"
            android:layout_height="28px"
            android:layout_marginTop="18px"
            android:scaleType="fitXY"
            android:src = "@mipmap/b_icon_hint"></ImageView>
        <TextView
            android:id = "@+id/tv_tiaose_hint"
            android:layout_width="wrap_content"
            android:layout_height="62px"
            android:layout_marginLeft="10px"
            android:textColor="@color/colorB3B3B3"
            android:textSize="20px"
            android:gravity="center_vertical"
            android:text = "@string/functiton_none"
            ></TextView>
    </LinearLayout>

</FrameLayout>